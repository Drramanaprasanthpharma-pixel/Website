# Supabase project credentials.
# Used by any code that creates a Supabase client (e.g. via
# @supabase/supabase-js's createClient) to query the
# drug_incompatibilities table (see lib/drug-incompatibilities.ts).

# Public — safe to expose to the browser. Found in
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser, respects Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-side only, NEVER expose to the browser or commit to git.
# Required only for admin/write operations (bypasses RLS), per the
# "service role can modify" policy in the drug_incompatibilities migration.
SUPABASE_SERVICE_ROLE_KEY=
